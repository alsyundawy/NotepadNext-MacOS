# NotepadNext-MacOS Environment Variables Example
# Copy this file to .env for local configuration if needed.

# Target Qt version for build/packaging (e.g., 6.5, 6.8, 6.10, 6.11)
QT_RELEASE_VER=6.5

# Packaging distribution target (e.g., dmg)
DISTRIBUTION=dmg

# GitHub Personal Access Token (for local gh cli or automated release testing)
# GITHUB_TOKEN=ghp_example
